---
import type { Lab } from '../lib/labs';

interface Props {
  lab: Lab;
}

const { lab } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/jumpstarts/${lab.slug}`;

const duration = lab.durationMin > 0 ? `${lab.durationMin} min` : null;

// Lower-cased search haystack + category key drive the client-side filter.
const searchData = [lab.title, lab.category ?? '', ...lab.tags].join(' ').toLowerCase();
const categoryKeys = [lab.categoryKey, ...lab.tags].filter(Boolean).join('|').toLowerCase();
---
<a
  href={href}
  class="codelab-card group flex flex-col rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-lg dark:border-gray-800 dark:bg-gray-900 dark:hover:border-brand-500"
  data-search={searchData}
  data-categories={categoryKeys}
>
  {lab.category && (
    <span class="mb-2 inline-block text-xs font-semibold uppercase tracking-wide text-brand-600 dark:text-brand-300">
      {lab.category}
    </span>
  )}

  <h3 class="mb-2 text-lg font-semibold text-gray-900 group-hover:text-brand-600 dark:text-gray-100 dark:group-hover:text-brand-300">
    {lab.title}
  </h3>

  <div class="mt-auto flex items-center justify-between pt-4 text-sm text-gray-500 dark:text-gray-400">
    {duration ? (
      <span class="inline-flex items-center gap-1">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <circle cx="12" cy="12" r="9" />
          <path stroke-linecap="round" d="M12 7v5l3 2" />
        </svg>
        {duration}
      </span>
    ) : (
      <span></span>
    )}
    {lab.updated ? (
      <span class="text-xs text-gray-400 dark:text-gray-500">Updated {lab.updated}</span>
    ) : (
      <span class="font-medium text-brand-600 opacity-0 transition-opacity group-hover:opacity-100 dark:text-brand-300">
        Start &rarr;
      </span>
    )}
  </div>
</a>
