---
import { render } from 'astro:content';
import CodelabLayout from '../../layouts/CodelabLayout.astro';
import MarkdownLabLayout from '../../layouts/MarkdownLabLayout.astro';
import { getLabEmbed } from '../../lib/labs';
import { getAllLabs } from '../../lib/allLabs';
import { titleFor } from '../../lib/codelabs';

// One static page per lab at /jumpstarts/<slug>/. Legacy claat labs embed the
// original <google-codelab> element (its native step navigation + "time
// remaining" countdown keep working); Markdown labs render their compiled
// content in a prose shell.
export async function getStaticPaths() {
  const labs = await getAllLabs();
  return labs.map((lab) => ({
    params: { slug: lab.slug },
    props: { kind: lab.kind, slug: lab.slug, entry: lab.entry },
  }));
}

const { kind, slug, entry } = Astro.props;

let title = slug;
let html = '';
let Content: Awaited<ReturnType<typeof render>>['Content'] | null = null;

if (kind === 'md' && entry) {
  Content = (await render(entry)).Content;
  title = titleFor(entry);
} else {
  const embed = getLabEmbed(slug);
  title = embed.title;
  html = embed.html;
}
---
{kind === 'md' && Content ? (
  <MarkdownLabLayout title={title}>
    <Content />
  </MarkdownLabLayout>
) : (
  <CodelabLayout title={title}>
    {/* Raw claat markup. codelab-elements.js (loaded in the layout) upgrades the
        custom elements client-side into the interactive codelab. */}
    <Fragment set:html={html} />
  </CodelabLayout>
)}
