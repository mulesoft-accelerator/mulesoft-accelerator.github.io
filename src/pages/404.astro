---
import BaseLayout from '../layouts/BaseLayout.astro';

// GitHub Pages serves /404.html automatically for unknown paths on
// user/org sites, so this themed page shows up for any bad URL.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const gridHref = `${base}/jumpstarts`;
---
<BaseLayout title="Page not found · MuleSoft Jumpstarts" description="The page you were looking for could not be found.">
  <section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-24 text-center sm:px-6">
    <p class="text-7xl font-black tracking-tight text-brand-500">404</p>
    <h1 class="mt-4 text-2xl font-bold text-gray-900 dark:text-white sm:text-3xl">
      This jumpstart wandered off.
    </h1>
    <p class="mt-3 max-w-md text-gray-600 dark:text-gray-400">
      The page you were looking for doesn't exist or may have moved. Try the full
      catalog of guided, hands-on tutorials.
    </p>
    <a
      href={gridHref}
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-brand-500 px-5 py-2.5 font-medium text-white transition-colors hover:bg-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-300"
    >
      &larr; Browse all jumpstarts
    </a>
  </section>
</BaseLayout>
